{
  "name": "harpe-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "pnpm --filter @harpe/core build && pnpm --filter @harpe/sources build && vite build",
    "preview": "vite preview",
    "clean:dist": "rm -rf dist packages/*/dist apps/*/dist",
    "typecheck": "pnpm --filter @harpe/core build && pnpm --filter @harpe/sources build && tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/cli/tsconfig.json && tsc --noEmit -p packages/mcp/tsconfig.json && tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "test": "vitest run --project default",
    "test:watch": "vitest --project default",
    "test:live": "RUN_LIVE=1 vitest run --project live",
    "check:api": "node scripts/check-api-bundles.mjs",
    "test:e2e": "playwright test",
    "monitor": "node tests/live/monitor.mjs",
    "keep-warm": "node tests/live/keep-warm.mjs",
    "verify": "pnpm run typecheck && pnpm test && pnpm run build && pnpm run check:api && pnpm --filter @harpe/extension build && pnpm --filter @harpe/extension test",
    "postinstall": "pnpm --filter @harpe/core build && pnpm --filter @harpe/sources build"
  },
  "dependencies": {
    "@harpe/core": "workspace:*",
    "@harpe/sources": "workspace:*",
    "@tursodatabase/serverless": "^1.2.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "node-html-parser": "^6.1.13",
    "openseadragon": "^4.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "0.33.5",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.13.2",
    "@types/openseadragon": "^3.0.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  }
}
