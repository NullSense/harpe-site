{
  "name": "harpe-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run build -w @harpe/core && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist packages/*/dist",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/cli/tsconfig.json && tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:api": "node scripts/check-api-bundles.mjs",
    "test:e2e": "playwright test",
    "monitor": "node tests/live/monitor.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:api && npm run build -w @harpe/extension && npm test -w @harpe/extension",
    "postinstall": "npm run build -w @harpe/core"
  },
  "dependencies": {
    "@harpe/core": "*",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "node-html-parser": "^6.1.13",
    "openseadragon": "^4.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "0.33.5",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.13.2",
    "@types/openseadragon": "^3.0.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.1.14",
    "esbuild": "^0.28.1",
    "typescript": "~5.8.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
