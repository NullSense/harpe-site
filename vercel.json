{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/scan.ts": {
      "maxDuration": 30
    },
    "api/sauce.ts": {
      "maxDuration": 15
    },
    "api/iiif.ts": {
      "maxDuration": 10
    },
    "api/deepzoom.ts": {
      "maxDuration": 20
    },
    "api/tile.ts": {
      "maxDuration": 20
    },
    "api/x.ts": {
      "maxDuration": 15
    },
    "api/grab.ts": {
      "maxDuration": 30
    },
    "api/fetch.ts": {
      "maxDuration": 30
    },
    "api/art-stream.ts": {
      "maxDuration": 15
    },
    "api/analyze.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
