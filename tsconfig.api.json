{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@harpe/core": ["./packages/core/src/index.ts"],
      "@harpe/sources": ["./packages/sources/src/index.ts"]
    }
  },
  "include": ["api", "src/lib/server"]
}
